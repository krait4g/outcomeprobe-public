# Docker Compose에서 OutcomeProbe 서버에만 전달할 runtime secret 예시입니다.
# 이 파일을 .env.secrets로 복사하고 실제 값을 채우세요. .env.secrets는 Git에서 제외됩니다.

# 빈 예시값을 그대로 사용하지 말고 각 secretRef에 대응하는 실제 값을 채우세요.
OUTCOMEPROBE_SECRET_MY_APP_TOKEN=

# 실제 Target의 callback-signing-key에만 이 canonical 값을 사용하세요.
# Quick Start Reference Consumer는 OUTCOMEPROBE_DEMO_CALLBACK_SECRET으로 검증하므로,
# 아래 값을 켜면 두 값이 정확히 같아야 합니다. 일반 Quick Start에서는 주석 상태를 유지하세요.
# OUTCOMEPROBE_SECRET_CALLBACK_SIGNING_KEY=

# opt-in realtime user-service conformance kit과 실제 Target 연결을 위한 canonical secretRef 예시입니다.
# `realtime-target-token`은 Authorization header 전체값이므로 실제 파일에는 `Bearer <token>` 형식의
# 값을 넣습니다. 아래 두 줄은 의도적으로 주석·빈 값이며 같은 값을 재사용하지 마세요.
# OUTCOMEPROBE_SECRET_REALTIME_TARGET_TOKEN=
# OUTCOMEPROBE_SECRET_REALTIME_CALLBACK_SIGNING_KEY=
