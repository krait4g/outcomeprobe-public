{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outcomeprobe.io/schemas/target-profile.json",
  "title": "TargetProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string", "const": "outcomeprobe.io/v1alpha1" },
    "kind": { "type": "string", "const": "TargetProfile" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 63 }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUri", "allowedPaths", "allowedMethods"],
      "properties": {
        "baseUri": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/relativePath" }
        },
        "allowedMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
          }
        },
        "allowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(?:(?:\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*|[0-9A-Fa-f:]+)$"
          }
        },
        "allowedPorts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "defaultHeaders": {
          "type": "object",
          "propertyNames": { "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
          "additionalProperties": { "type": "string", "maxLength": 16384 }
        },
        "secretHeaders": {
          "type": "object",
          "propertyNames": { "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretRef"],
            "properties": {
              "secretRef": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
              }
            }
          }
        },
        "callbackPaths": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "additionalProperties": { "$ref": "#/definitions/relativePath" }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "headers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              }
            },
            "jsonPaths": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "description": "Deprecated: spec.allowedHosts와 spec.allowedPorts를 사용하세요.",
          "properties": {
            "allowedHosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^(?:(?:\\*\\.)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*|[0-9A-Fa-f:]+)$"
              }
            },
            "allowedPorts": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/(?!/)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*(?:%2[eE]|%2[fF]|%5[cC]|%25))[^\\r\\n?#]*$"
    }
  }
}
