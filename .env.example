# OutcomeProbe 로컬 데모 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 비어 있는 DB·callback·Control API 값을 서로 다르게 채우세요.
# .env와 실제 secret은 저장소에 커밋하지 마세요.

OUTCOMEPROBE_SERVER_PORT=8080
OUTCOMEPROBE_WEB_PORT=3000
OUTCOMEPROBE_DB_NAME=outcomeprobe
OUTCOMEPROBE_DB_USER=outcomeprobe
OUTCOMEPROBE_DB_PASSWORD=
OUTCOMEPROBE_DEMO_CALLBACK_SECRET=

# Control API·Web·CLI가 공유하는 단일 운영자 토큰(32~512자 제한된 token68 문자열)
# Emulator ingress token이나 Target secret과는 별도 값으로 생성하세요.
OUTCOMEPROBE_CONTROL_API_TOKEN=

# terminal Run 보존 기간과 동시 실행 상한
OUTCOMEPROBE_RETENTION_DAYS=14
OUTCOMEPROBE_MAX_CONCURRENT_RUNS=10

# bootstrap이 공개 YAML 다섯 개를 명시적으로 import하므로 자동 Profile seed는 끕니다.
OUTCOMEPROBE_DEMO_PROFILE_SEEDING_ENABLED=false

# Emulator ingress token. 비어 있으면 로컬 데모에서 token 검증을 사용하지 않습니다.
OUTCOMEPROBE_EMULATOR_TOKEN=

# 로그 레벨 (TRACE, DEBUG, INFO, WARN, ERROR)
OUTCOMEPROBE_LOG_LEVEL=INFO

# Compose read-only mount override에서 사용할 host 디렉터리입니다.
# OUTCOMEPROBE_SECRETS_HOST_DIRECTORY=./secrets
